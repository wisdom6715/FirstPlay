rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Architecture
    // ===============================================================
    // Dynamic Admin Authorization Model:
    // - Authenticated users are checked against the `/admins/{adminId}` whitelist table.
    // - Document ID in `/admins` can be either the admin's Firebase Auth UID or the lowercase email.
    // - Documents with `active: false` are deactivated.
    // - MFA TOTP secret (`totp_secret`) is stored in `/admins/{adminId}`.
    // - Public Storefront / Content: /apps, /listings, /promotional, /tournaments, etc.
    // ===============================================================

    // Helper: Verify if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Dynamic Admin Whitelist Verification
    // Checks if authenticated user exists in the `/admins` collection by UID or email (lowercase/exact)
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false) ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active != false) ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active != false)
      );
    }

    // 1. Administrators Collection
    // Read: All authenticated users can read so catalogService.verifyAdminUser can verify whitelist and retrieve TOTP secret during login
    // Write: Restricted to admins or the specific authenticated admin managing their own record (e.g. self-enrolling MFA TOTP secret)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && (request.auth.uid == adminId || (request.auth.token.email != null && request.auth.token.email.lower() == adminId.lower())));
    }

    // 2. Administrative Catalog & Content
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotional/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotional_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Submissions from Public /promote View
    // Public game and campaign submission on /promote; moderation restricted to admins.
    match /under_review/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /pending_campaigns/{campaignId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 4. Tournaments & Leaderboards
    // Tournaments managed by admins, read by all.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tournament participants: public join and score submission.
    match /tournament_participants/{participantId} {
      allow read, write: if true;
    }

    // Prize redemptions: public claim and status updates.
    match /prize_redemptions/{redemptionId} {
      allow read, write: if true;
    }

    // 5. Rewards & Redemption Engine
    // Wheel configs, categories, gifts managed by admins.
    match /gift_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wheel_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Spin gifts, redemptions, and redemption contact entries.
    match /spin_gift/{giftDocId} {
      allow read, write: if true;
    }

    match /redemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /redemption_contacts/{contactId} {
      allow read, write: if true;
    }

    // 6. User Profiles & Handles
    match /usernames/{usernameId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    // Default Deny Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
